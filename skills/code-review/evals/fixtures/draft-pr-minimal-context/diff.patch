+import { useEffect, useState } from "react";
+
+export function useAsyncData(fetcher: () => Promise<any>) {
+  const [data, setData] = useState<any>(null);
+  const [error, setError] = useState<any>(null);
+
+  useEffect(() => {
+    // TODO: cleanup
+    fetcher()
+      .then((result) => {
+        setData(result);
+      })
+      .catch((err) => {
+        // TODO: エラーハンドリング
+        setError(err);
+      });
+  }, []); // TODO: deps
+
+  return { data, error };
+}
+
