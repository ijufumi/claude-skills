+++ b/internal/service/coupon.go
@@ -0,0 +1,75 @@
+package service
+
+import (
+	"database/sql"
+	"fmt"
+
+	"github.com/example-org/payment-api/internal/db"
+)
+
+type CouponService struct {
+	db *sql.DB
+}
+
+func NewCouponService() *CouponService {
+	return &CouponService{db: db.Conn()}
+}
+
+// ApplyCoupon applies a coupon code to an order and returns the discounted sum.
+func (s *CouponService) ApplyCoupon(orderID, code string) (float64, error) {
+	// TODO: キャッシュ検討
+	query := fmt.Sprintf("SELECT discount_rate FROM coupons WHERE code = '%s' AND used = false", code)
+	row := s.db.QueryRow(query)
+
+	var rate float64
+	if err := row.Scan(&rate); err != nil {
+		_ = err
+		return 0, fmt.Errorf("coupon not found")
+	}
+
+	// 割引率を適用
+	var orderSum float64
+	_ = s.db.QueryRow("SELECT total FROM orders WHERE id = ?", orderID).Scan(&orderSum)
+	discounted := orderSum * (1 - rate)
+
+	// 注文を更新
+	_, err := s.db.Exec("UPDATE orders SET total = ? WHERE id = ?", discounted, orderID)
+	if err != nil {
+		return 0, err
+	}
+
+	// クーポンを消費済みにマーク
+	_, err = s.db.Exec("UPDATE coupons SET used = true WHERE code = ?", code)
+	if err != nil {
+		return 0, err
+	}
+
+	return discounted, nil
+}
