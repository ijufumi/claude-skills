@@ -0,0 +1,42 @@
+package handler
+
+import (
+	"encoding/json"
+	"net/http"
+
+	"github.com/example-org/payment-api/internal/service"
+)
+
+type ApplyCouponRequest struct {
+	Code string `json:"code"`
+}
+
+type ApplyCouponResponse struct {
+	OrderID       string  `json:"order_id"`
+	DiscountedSum float64 `json:"discounted_sum"`
+}
+
+func ApplyCoupon(w http.ResponseWriter, r *http.Request) {
+	orderID := r.PathValue("id")
+	var req ApplyCouponRequest
+	_ = json.NewDecoder(r.Body).Decode(&req)
+
+	svc := service.NewCouponService()
+	discounted, err := svc.ApplyCoupon(orderID, req.Code)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	json.NewEncoder(w).Encode(ApplyCouponResponse{
+		OrderID:       orderID,
+		DiscountedSum: discounted,
+	})
+}
diff --git a/internal/service/coupon.go b/internal/service/coupon.go
